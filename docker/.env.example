# Copy to .env and adjust for the host.

# Base directory for all service data (configs, databases, flows).
DATA_DIR=/home/pi

# Time zone for all containers.
TZ=Europe/Berlin

# Zigbee coordinator, by stable path: ls /dev/serial/by-id/
ZIGBEE_DONGLE=/dev/serial/by-id/usb-SONOFF_SONOFF_Dongle_Plus_MG24_<serial>-if00-port0

# Mount point of the external HDD, shared on the LAN by the samba service.
HDD_DIR=/mnt/hdd

# Name of the Samba share and the account to connect with.
SAMBA_SHARE=HDD
SAMBA_USER=samba
SAMBA_PASSWORD=change-me

# Compose project name. It prefixes the named volumes (e.g. pi_portainer_data), so changing it
# on an existing host starts Portainer with an empty volume. The current Pi uses "pi".
COMPOSE_PROJECT_NAME=pi

# Nextcloud: major version of the image (one step at a time when upgrading), data directory on
# the host, published port, database version and passwords.
NEXTCLOUD_VERSION=35
NEXTCLOUD_DATA_DIR=/var/nextcloud/data
NEXTCLOUD_PORT=8090
NEXTCLOUD_DB_VERSION=10.11
NEXTCLOUD_DB_PASSWORD=change-me
NEXTCLOUD_DB_ROOT_PASSWORD=change-me

# Nextcloud backup (docker/jobs/backup-nextcloud.sh): the password of the restic repository on the
# HDD. install.sh generates it. WITHOUT IT THE BACKUP CANNOT BE READ: keep a copy outside the Pi,
# e.g. in a password manager.
NEXTCLOUD_BACKUP_PASSWORD=change-me

# SMART health check of the HDD: a stable device path (ls -l /dev/disk/by-id/), e.g.
# /dev/disk/by-id/usb-<model>_<serial>-0:0 (the whole disk, not a partition); empty = no check.
# HDD_SMART_TYPE is smartctl's -d type; change it if the check cannot read the disk.
HDD_DEVICE=
HDD_SMART_TYPE=sat
# The same for the system SSD (the whole disk, e.g. /dev/disk/by-id/usb-<model>_<serial>-0:0)
SSD_DEVICE=
SSD_SMART_TYPE=sat

# Alerts by email (docker/jobs): problems found by the monitor, failed backups, disk problems and
# the weekly report. SMTP server of the sending account, e.g. smtps://smtp.gmail.com:465, with an
# app password (not the account password). Empty = no email, only Nextcloud notifications.
ALERT_SMTP_URL=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# Sender (default: ALERT_SMTP_USER) and recipient
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Service ports the monitor checks, as name:port
MONITOR_PORTS=mosquitto:1883 nodered:1880 homebridge:8581 samba:445 portainer:9000
# Alert when the guest exit node has carried more than this many GiB in a month (0 = never)
GUEST_EXIT_MONTHLY_LIMIT_GB=0

# Optional exit node for a guest (see docker/README.md): COMPOSE_PROFILES=guest-exit starts it.
# The auth key is a one-time Tailscale key, only needed for the first start.
GUEST_EXIT_HOSTNAME=guest-exit
GUEST_EXIT_AUTHKEY=

# Tailscale (see docker/README.md). TS_AUTHKEY is only for a node without state; a rebuilt Pi
# restores the old state instead (TAILSCALE_STATE for scripts/install.sh). TS_HOSTNAME keeps the
# node's name, TS_ROUTES offers a network (e.g. the LAN) to the tailnet.
TS_AUTHKEY=
TS_HOSTNAME=
TS_ROUTES=

# Scheduled jobs: the home-config clone (state backup) and the Nextcloud user who gets the weekly
# update notice (empty = no update check)
HOME_CONFIG_DIR=../../home-config
NEXTCLOUD_NOTIFY_USER=
