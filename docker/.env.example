# Copy to .env and adjust for the host.

# Base directory for all service data (configs, databases, flows).
DATA_DIR=/home/pi

# Time zone for all containers.
TZ=Europe/Berlin

# Zigbee coordinator, by stable path: ls /dev/serial/by-id/
ZIGBEE_DONGLE=/dev/serial/by-id/usb-SONOFF_SONOFF_Dongle_Plus_MG24_<serial>-if00-port0

# Mount point of the external HDD, shared on the LAN by the samba service.
HDD_DIR=/mnt/hdd

# Name of the Samba share and the account to connect with.
SAMBA_SHARE=HDD
SAMBA_USER=samba
SAMBA_PASSWORD=change-me

# Compose project name. It prefixes the named volumes (e.g. pi_portainer_data), so changing it
# on an existing host starts Portainer with an empty volume. The current Pi uses "pi".
COMPOSE_PROJECT_NAME=pi

# Nextcloud: major version of the image (one step at a time when upgrading), data directory on
# the host, published port, database version and passwords.
NEXTCLOUD_VERSION=23
NEXTCLOUD_DATA_DIR=/var/nextcloud/data
NEXTCLOUD_PORT=8090
NEXTCLOUD_DB_VERSION=10.6
NEXTCLOUD_DB_PASSWORD=change-me
NEXTCLOUD_DB_ROOT_PASSWORD=change-me
