  {
   "id": 8,
   "type": "row",
   "title": "Checks and backups (from the monitor; email alerts come from there)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "table",
   "title": "Monitor checks",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "expr": "home_check_problem",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true
      },
      "renameByName": {
       "check": "Check",
       "Value": "State"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "State",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK"
        },
        "1": {
         "text": "PROBLEM"
        }
       }
      }
     ],
     "custom": {
      "cellOptions": {
       "type": "color-background"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {}
  },
